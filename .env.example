# Copy to .env for local runs. Nothing here is a secret; real secrets never go in the repo.
IEP_DATA_CLASS=synthetic
DATABASE_URL=postgres://iep:local-only-not-a-secret@localhost:5432/iep
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info
# Local stand-in for Cloud KMS: a random key is created in this file on first start (gitignored).
IEP_FIELD_KEY_FILE=.local/field.key
