    "check:csp": "node scripts/check-csp.mjs",
    "test:e2e": "vite build && playwright test",
    "typecheck:e2e": "tsc -p e2e"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "vite": "^7.2.0"
  }
}
