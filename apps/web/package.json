{
  "name": "@iep/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GoalLine on the web: installable app for Windows and phones. Fake data only.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
